# .env.local로 복사해서 값을 채우세요. 실제 키는 커밋하지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두어를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 키를 Supabase Auth에 등록한 뒤 true로 바꾸면 카카오 로그인 버튼이 켜집니다.
NEXT_PUBLIC_KAKAO_LOGIN_ENABLED=false

# 계좌이체 안내(결제 모드 manual). 서버 전용이며 비어 있으면 화면에 "[확정 후 기재]"로 보입니다.
BANK_NAME=
BANK_HOLDER=
BANK_ACCOUNT=
